{"root":{"data":{"id":"dkgo40655ww0","created":1785898298523,"text":"方法管理","note":"对客户库存的标准样品进行管理，记录库存量，标样的批号，过期日期，数量，标准值，不\n确定度这些信息。并与测试方法的分析项进行关联。\n浓度里的数据来源与数据维护，有数据维护跟测试方法分析项关联"},"children":[{"data":{"id":"dkgocuyzrgg0","created":1785898992484,"text":"评价标准管理","note":"记录仪器的基本信息"},"children":[{"data":{"id":"dkgotvkudrc0","created":1785900325996,"text":"评价标准管理"},"children":[]}]},{"data":{"id":"dkgocw7ypo00","created":1785898995203,"text":"监测模板管理","note":"浓度、批次、有效明等","layout_mind_offset":{"x":-139.99999791383755,"y":58.999999120831376}},"children":[{"data":{"id":"dkgoj84rk2w0","created":1785899491316,"text":"监测模板类型"},"children":[]},{"data":{"id":"dkgojjpdssw0","created":1785899516508,"text":"监测方案","note":"可以与分析项进行关联"},"children":[]},{"data":{"id":"dkgorr1acmw0","created":1785900159378,"text":"监测类型"},"children":[]}]},{"data":{"id":"dkgocwrh0jc0","created":1785898996383,"text":"监测能力管理","note":"维护计划是设置仪器需要维护的周期，维护记录是仪器维修过程的记录;可以还有检定/.","layout_mind_offset":{"x":132.99999801814545,"y":-39.99999940395361}},"children":[{"data":{"id":"dkgooy5n7aw0","created":1785899939787,"text":"分析项"},"children":[]},{"data":{"id":"dkgop1anybs0","created":1785899946620,"text":"分析项组"},"children":[]},{"data":{"id":"dkgop1swbnc0","created":1785899947723,"text":"测试关联仪器"},"children":[]},{"data":{"id":"dkgop29p75s0","created":1785899948739,"text":"样品类型"},"children":[]},{"data":{"id":"dkgopv5re140","created":1785900011627,"text":"方法参数"},"children":[]}]},{"data":{"id":"dkgocx9x9e80","created":1785898997499,"text":"标准方法管理","note":"分析时选择仪器，自动记录仪器的使用记录"},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}